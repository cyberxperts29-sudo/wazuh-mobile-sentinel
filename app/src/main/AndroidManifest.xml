<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed to POST collected data to the backend receiver -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Android 11+ Package Visibility: without this, AppInstallReceiver never
         fires for other apps' installs (logcat shows "AppsFilter: interaction:
         ...BLOCKED"). Justified here since the app's entire purpose is
         monitoring all installed apps for security posture; Play Store
         publishing would require declaring this justification in Play
         Console, but that's out of scope for sideloaded/debug builds. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Android 8+ Background Execution Limits: without an active/foreground
         process, manifest-declared receivers (even package-specific ones like
         PACKAGE_ADDED) are skipped at broadcast enqueue time (confirmed via
         dumpsys activity broadcasts history-forced). MonitoringService keeps
         the process alive via a persistent low-priority notification so
         AppInstallReceiver actually gets invoked. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.WazuhMobileSentinel">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.WazuhMobileSentinel">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".MonitoringService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Device security posture monitoring for Wazuh SIEM integration" />
        </service>

    </application>

</manifest>
